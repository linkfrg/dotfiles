    { device = "/dev/disk/by-uuid/D6D1-D652";
      fsType = "vfat";
      options = [ "fmask=0022" "dmask=0022" ];
    };

  swapDevices =
    [ { device = "/dev/disk/by-uuid/9dc5d165-4080-40c6-a9de-d6586aba3d5c"; }
